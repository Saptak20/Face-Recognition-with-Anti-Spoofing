# AegisID — Face Recognition with Anti-Spoofing
# Environment Variable Template
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets to version control!

# =============================================================================
# REQUIRED FOR PRODUCTION (must be set in Render dashboard or deployment environment)
# =============================================================================

# JWT secret for token signing (generate a strong random string)
# Generate with: openssl rand -hex 32
FACE_RECOGNITION_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API key for authenticated endpoints (optional, enable with FACE_RECOGNITION_API_KEY_REQUIRED=true)
# Generate with: openssl rand -hex 16
FACE_RECOGNITION_API_KEY=your-api-key-here

# MFA Email Configuration (required if FACE_RECOGNITION_ENABLE_MFA=true)
# Use an app-specific password for Gmail, not your main password
FACE_RECOGNITION_SENDER_EMAIL=your-email@gmail.com
FACE_RECOGNITION_SENDER_PASSWORD=your-app-specific-password

# =============================================================================
# PERSISTENCE PATHS (configured for Render persistent disk at /var/data)
# =============================================================================

# SQLite database path
FACE_RECOGNITION_DB_PATH=/var/data/face_recognition.db

# FAISS index path
FACE_RECOGNITION_FAISS_INDEX_PATH=/var/data/embeddings/face_index.faiss

# Backup directory
FACE_RECOGNITION_BACKUP_PATH=/var/data/backups

# Data, logs, and models directories
FACE_RECOGNITION_DATA_DIR=/var/data
FACE_RECOGNITION_LOGS_DIR=/var/data/logs
FACE_RECOGNITION_MODELS_DIR=/var/data/models

# Log file
FACE_RECOGNITION_LOG_FILE=/var/data/logs/face_recognition.log
FACE_RECOGNITION_LOG_FILE_ENABLED=true

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development, staging, production
FACE_RECOGNITION_ENVIRONMENT=development

# API server
FACE_RECOGNITION_HOST=0.0.0.0
FACE_RECOGNITION_PORT=8000
FACE_RECOGNITION_DEBUG=false
FACE_RECOGNITION_WORKERS=1

# Security
FACE_RECOGNITION_API_KEY_REQUIRED=false
FACE_RECOGNITION_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# CORS (comma-separated list)
# FACE_RECOGNITION_ALLOWED_ORIGINS=https://your-frontend.com,https://admin.your-frontend.com

# MFA
FACE_RECOGNITION_ENABLE_MFA=false
FACE_RECOGNITION_SMTP_SERVER=smtp.gmail.com
FACE_RECOGNITION_SMTP_PORT=587

# Logging
FACE_RECOGNITION_LOG_LEVEL=INFO

# Models
FACE_RECOGNITION_DEVICE=cpu
FACE_RECOGNITION_EMBEDDING_MODEL=vggface2
FACE_RECOGNITION_EMBEDDING_DIM=512
FACE_RECOGNITION_LIVENESS_THRESHOLD=0.5
FACE_RECOGNITION_DEEPFAKE_THRESHOLD=0.5

# Authentication thresholds
FACE_RECOGNITION_FACE_SIMILARITY_THRESHOLD=0.7
FACE_RECOGNITION_OVERALL_CONFIDENCE_THRESHOLD=0.6

# Database
FACE_RECOGNITION_FAISS_INDEX_TYPE=IndexFlatIP
FACE_RECOGNITION_BACKUP_ENABLED=true
FACE_RECOGNITION_MAX_BACKUPS=7

# =============================================================================
# LOCAL DEVELOPMENT OVERRIDES (uncomment and adjust as needed)
# =============================================================================

# Use local paths instead of /var/data for development
# FACE_RECOGNITION_DB_PATH=data/face_recognition.db
# FACE_RECOGNITION_FAISS_INDEX_PATH=data/embeddings/face_index.faiss
# FACE_RECOGNITION_BACKUP_PATH=data/backups
# FACE_RECOGNITION_DATA_DIR=data
# FACE_RECOGNITION_LOGS_DIR=logs
# FACE_RECOGNITION_MODELS_DIR=models
# FACE_RECOGNITION_LOG_FILE=logs/face_recognition.log

# Enable debug mode for development
# FACE_RECOGNITION_DEBUG=true

# Use GPU if available
# FACE_RECOGNITION_DEVICE=cuda